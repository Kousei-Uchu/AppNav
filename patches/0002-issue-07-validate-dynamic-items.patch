+
+const diag = (
+  env: RecordValidationEnv,
+  code: string,
+  message: string,
+  at?: { line?: number; column?: number },
+  ids?: string[],
+): Diagnostic => ({ severity: "error", code, message, file: env.file, line: at?.line, column: at?.column, ids });
