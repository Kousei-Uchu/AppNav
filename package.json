{
  "name": "routegraph",
  "version": "0.1.0",
  "description": "Typed navigation graphs for apps: a compact .navgraph format, pathfinding, and JSON instruction generation with extension hooks. Works in React Native, browsers and Node.",
  "keywords": [
    "navigation",
    "graph",
    "pathfinding",
    "astar",
    "dijkstra",
    "react-native",
    "ui-automation",
    "tutorial",
    "typescript",
    "dsl"
  ],
  "license": "MIT",
  "author": "Sorren",
  "sideEffects": false,
  "type": "commonjs",
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas/navschema-v1.schema.json": "./schemas/navschema-v1.schema.json",
    "./react": {
      "import": { "types": "./dist/react.d.mts", "default": "./dist/react.mjs" },
      "require": { "types": "./dist/react.d.ts", "default": "./dist/react.js" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "node tools/scan-app.js",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kousei-Uchu/routegraph.git"
  },
  "homepage": "https://github.com/Kousei-Uchu/routegraph#readme",
  "bugs": {
    "url": "https://github.com/Kousei-Uchu/routegraph/issues"
  }
}
